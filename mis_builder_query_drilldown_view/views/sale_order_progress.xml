<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_progress_tree" model="ir.ui.view">
        <field name="model">sale.order.progress</field>
        <field name="name">sale.order.progress.tree</field>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <tree string="Sales Order Progress" create="false">
                <field name="date"/>
                <field name="payment_term_id"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="is_advance"/>
                <field name="amount_percent"/>
                <field name="amount_advance_toinvoice" sum="Total Advance to Invoice"/>
                <field name="amount_toinvoice" sum="Total to Invoice"/>
                <field name="amount_advance_invoiced" sum="Total Advance Invoiced"/>
                <field name="amount_advance_returned" sum="Total Advance Returned"/>
                <field name="amount_invoiced" sum="Total Invoiced"/>
                <field name="residual_toinvoice" sum="Residual to Invoice"/>
                <field name="invoiced"/>
            </tree>
        </field>
    </record>
</odoo>
