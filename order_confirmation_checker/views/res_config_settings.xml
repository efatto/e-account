<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block
                    title="Order Confirmation Check"
                    name="order_confirmation_checker"
                >
                    <setting
                        id="order_confirmation_ai_connection"
                        string="AI connection"
                        help="AI connection used to read order confirmations and create sale order lines from attachments"
                    >
                        <field name="order_confirmation_ai_connection_id" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
