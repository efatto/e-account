<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="wizard_account_invoice_report_export">
        <field name="name">Export e-invoice previews</field>
        <field name="model">wizard.account.invoice.export</field>
        <field name="arch" type="xml">
            <form string="Export e-invoice previews">
                <field name="export_report_name" />
                <separator colspan="4" />
                <group>
                    <button
                        string="Export e-invoice previews"
                        name="export_report"
                        type="object"
                    />
                    <button string="Cancel" special="cancel" />
                </group>
            </form>
        </field>
    </record>
    <record id="action_report_invoice_export" model="ir.actions.act_window">
        <field name="name">Export e-invoice previews</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.account.invoice.export</field>
        <field
            name="binding_model_id"
            ref="l10n_it_fatturapa_in.model_fatturapa_attachment_in"
        />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
