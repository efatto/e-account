<?xml version="1.0" ?>
<odoo>

    <record id="account_invoice_form_intrastat_info" model="ir.ui.view">
        <field name="name">account.invoice.form.intrastat.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button
                    name="action_insert_intrastat_data_in_move_lines"
                    type="object"
                    string="Insert intrastat data"
                    attrs="{'invisible': ['|',
                        ('move_type', 'not in', ['out_invoice', 'out_refund', 'out_receipt']),
                        ('state', '!=', 'draft')]}"
                />
                <button
                    name="action_remove_intrastat_data_in_move_lines"
                    type="object"
                    string="Remove intrastat data"
                    attrs="{'invisible': ['|',
                        ('move_type', 'not in', ['out_invoice', 'out_refund', 'out_receipt']),
                        ('state', '!=', 'draft')]}"
                />
            </button>
        </field>
    </record>

</odoo>
