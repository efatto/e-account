<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="riba_accreditation" model="ir.ui.view">
        <field name="name">riba.accreditation.wizard</field>
        <field name="model">riba.accreditation</field>
        <field name="inherit_id" ref="l10n_it_ricevute_bancarie.riba_accreditation" />
        <field name="arch" type="xml">
            <field name="accreditation_journal_id" position="after">
                <field name="date_accreditation" />
            </field>
            <field name="bank_expense_account_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="expense_amount" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <footer position="attributes">
                <attribute name="invisible">1</attribute>
            </footer>
            <xpath expr="//form" position="inside">
                <button
                    string="Create"
                    name="create_move"
                    type="object"
                    default_focus="1"
                    class="oe_highlight"
                />
                <button string="Cancel" special="cancel" class="oe_link" />
            </xpath>
        </field>
    </record>

    <record id="riba_line_accreditation" model="ir.ui.view">
        <field name="name">riba.accreditation.line.wizard</field>
        <field name="model">riba.accreditation</field>
        <field name="arch" type="xml">
            <form string="Ri.Ba. Line Accreditation">
                <separator
                    string="This wizard generates the journal entry related to accreditation received from the bank"
                    colspan="4"
                />
                <group>
                <field name="accreditation_journal_id" />
                <field name="date_accreditation" />
                </group>
                <group>
                <field name="accreditation_account_id" />
                <field name="accreditation_amount" />
                <field name="bank_account_id" />
                <field name="bank_amount" />
                </group>
                <button
                    string="Cancel"
                    special="cancel"
                    icon="fa-times-circle text-danger"
                    colspan="2"
                />
                <button
                    string="Create"
                    name="create_move"
                    type="object"
                    icon="fa-check text-success"
                    colspan="2"
                />
                <separator
                    string="You can also skip this step and set the distinta status to 'accredited' anyway"
                    colspan="4"
                />
                <button
                    string="Skip and confirm accreditation"
                    name="skip"
                    type="object"
                    icon="fa-check text-success"
                    colspan="4"
                />
            </form>
        </field>
    </record>

    <record id="action_riba_line_accreditation" model="ir.actions.act_window">
        <field name="name">Ri.Ba. Accreditation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">riba.accreditation</field>
        <field
            name="binding_model_id"
            ref="l10n_it_ricevute_bancarie.model_riba_distinta_line"
        />
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="riba_line_accreditation" />
    </record>

</odoo>
