<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="riba_line_accrual" model="ir.ui.view">
        <field name="name">riba.accrual.line.wizard</field>
        <field name="model">riba.accrual</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Ri.Ba. Line Accrual">
                <separator
                    string="This wizard generates the journal entry related to accrual received from the bank"
                    colspan="4"
                />
                <group>
                    <field name="accreditation_journal_id" />
                    <field name="date_accrual" />
                </group>
                <group>
                    <field name="accreditation_account_id" />
                    <field name="accrual_amount" />
                    <field name="acceptance_account_id" />
                </group>
                <button
                    string="Cancel"
                    special="cancel"
                    icon="fa-times-circle text-danger"
                    colspan="2"
                />
                <button
                    string="Create"
                    name="create_accrue_move"
                    type="object"
                    icon="fa-check text-success"
                    colspan="2"
                />
            </form>
        </field>
    </record>

    <record id="action_riba_line_accrual" model="ir.actions.act_window">
        <field name="name">C/O Accrual</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">riba.accrual</field>
        <field
            name="binding_model_id"
            ref="l10n_it_ricevute_bancarie.model_riba_distinta_line"
        />
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="riba_line_accrual" />
    </record>

</odoo>
