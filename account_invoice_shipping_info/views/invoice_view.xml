<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field
            name="name"
        >Add carrier tracking and dimension to shipping data in invoice form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_accompanying_invoice.view_move_form" />
        <field name="arch" type="xml">
            <group name="shipping_transport" position="inside">
                <field name="carrier_tracking_ref" />
                <field name="dimension" />
            </group>
        </field>
    </record>
</odoo>
