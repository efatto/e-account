<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_weight" model="ir.ui.view">
        <field name="name">account.invoice.form.weight</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_accompanying_invoice.view_move_form" />
        <field name="arch" type="xml">
            <group name="shipping_parcels" position="inside">
                <field name="compute_weight" />
            </group>
            <field name="delivery_packages" position="after">
                <field name="stock_package_ids" string="Packages custom">
                    <list>
                        <field name="dimensions" />
                        <field name="weight_custom" />
                        <field name="weight_custom_uom_id" />
                        <field name="goods_appearance_id" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>
