<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_form_send_shipping_email" model="ir.ui.view">
        <field name="name">account.invoice.form.shippin.email</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_invoice_shipping_info.view_move_form" />
        <field name="arch" type="xml">
            <group name="shipping_info" position="inside">
                <group name="shipping_email_info" string="Shipping Email Info">
                    <field name="shipping_email_state" />
                    <field name="shipping_email_date" />
                </group>
            </group>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_send_shipping_email"
                    string="Send shipping Email"
                    type="object"
                    icon="fa-send"
                    invisible="(shipping_email_state != 'no' or move_type not in ['in_refund', 'out_invoice'])"
                />
                <button
                    name="action_send_shipping_email"
                    string="Re-Send shipping Email"
                    type="object"
                    icon="fa-send"
                    invisible="(shipping_email_state != 'sent' or move_type not in ['in_refund', 'out_invoice'])"
                />
                <button
                    name="action_set_shipping_confirmed"
                    string="Set shipping confirmed"
                    type="object"
                    icon="fa-ship"
                    invisible="(shipping_email_state != 'sent' or move_type not in ['in_refund', 'out_invoice'])"
                />
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="view_out_invoice_tree">
        <field name="name" />
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field
                    name="shipping_email_state"
                    widget="badge"
                    decoration-success="shipping_email_state == 'confirmed'"
                    decoration-info="shipping_email_state == 'sent'"
                    optional="show"
                />
            </field>
        </field>
    </record>
</odoo>
